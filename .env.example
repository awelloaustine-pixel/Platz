# Copy to .env.local, and add the same values in Vercel. PLACEHOLDER — Victor to supply.

# The final domain.
NEXT_PUBLIC_SITE_URL=https://platinummarketingagency.co.ke

# --- Where contact form leads go: "sheets" (default) or "resend". ---
LEAD_DESTINATION=sheets

# Google Sheets. See docs/sheets-webhook.gs for the five-minute setup.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# Resend email, if LEAD_DESTINATION=resend. The "from" address must be on a domain verified with Resend.
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=

# Booking calendar, such as https://calendly.com/your-name/10min
# Until this is set, the contact page offers booking on WhatsApp instead.
NEXT_PUBLIC_CALENDLY_URL=

# --- Analytics: "ga4", "plausible", or leave empty for none. ---
NEXT_PUBLIC_ANALYTICS=
# For ga4. It only loads after a visitor accepts the cookie banner.
NEXT_PUBLIC_GA_ID=
# For plausible. Sets no cookies, so it shows no banner.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
